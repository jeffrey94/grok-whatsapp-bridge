{
  "gateway": {
    "url": "http://127.0.0.1:1340",
    "tokenFile": "/home/box/sand-data/gateway.json"
  },
  "defaultAgent": "<default-agent-id>",
  "dms": [
    { "id": "+<owner-phone-digits>", "name": "Owner" },
    { "id": "<owner-lid-digits>@lid", "name": "Owner (LID form, optional)" }
  ],
  "groups": [
    {
      "jid": "<group-id>@g.us",
      "name": "Quotes",
      "agent": "<quotes-agent-id>",
      "mode": "mention",
      "keywords": ["quote", "quotation"]
    },
    {
      "jid": "<another-group-id>@g.us",
      "name": "Job reports",
      "agent": "<job-reports-agent-id>",
      "mode": "all",
      "allowSenders": ["+<tech-1-phone-digits>", "+<tech-2-phone-digits>"]
    }
  ],
  "authDir": "auth",
  "statePath": "state/bridge-state.json",
  "statusPath": "state/status.json",
  "replyTimeoutMs": 600000,
  "maxMessageAgeSec": 600,
  "catchUpMaxAgeMs": 1200000,
  "sendDelayMs": 1200,
  "typingIndicator": true,
  "quoteInDms": false,
  "limits": {
    "outboundPerChatPerMinute": 6,
    "outboundGlobalPerMinute": 20,
    "inboundPerSenderPerMinute": 8,
    "inboundPerChatPerMinute": 20,
    "replyWindowMs": 900000
  },
  "bundling": {
    "albumDebounceMs": 1800,
    "burstWindowMs": 3000,
    "maxWaitMs": 8000,
    "maxItems": 10
  },
  "ignoreSenders": [],
  "logLevel": "info"
}
